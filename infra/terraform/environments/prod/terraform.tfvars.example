# Copy to terraform.tfvars (git-ignored) and fill in. Example values only.
account_id = "123456789012"
image_tag  = "901174a"
api_domain = "api.pay.example.com"

hosted_zone_id = "Z0123456789EXAMPLE"
certificate_arns = {
  primary = "arn:aws:acm:ap-south-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"
  dr      = "arn:aws:acm:ap-south-2:123456789012:certificate/00000000-0000-0000-0000-000000000000"
}

# Each PSP's published webhook source ranges (documentation ranges shown); code = provider code without underscores.
psp_webhook_sources = {
  RAZORPAY = ["192.0.2.0/28"]
  CASHFREE = ["198.51.100.0/28"]
}

admin_ipv4_cidrs = ["203.0.113.0/24"]

oidc = {
  issuer   = "https://login.example.com/realms/payments"
  jwks_uri = "https://login.example.com/realms/payments/protocol/openid-connect/certs"
  audience = "payment-gateway-admin"
}
